// ============================================================================
//  Copy this file to `src/secrets.h` and fill in the real values.
//  `src/secrets.h` is gitignored so your keys never hit version control.
// ============================================================================
#pragma once

// ---- Wi-Fi -----------------------------------------------------------------
// The on-device Wi-Fi picker (Settings -> WIFI) can overwrite these at
// runtime and persist the result in NVS. These values are only the
// first-boot fallback.
#define WIFI_SSID      "your-wifi-name"
#define WIFI_PASSWORD  "your-wifi-password"

// ---- Solana wallet ---------------------------------------------------------
// The wallet is generated on-device at first boot and stored in NVS.
// Reveal or rotate it from the web UI (Settings -> WALLET). Leave this
// empty unless you want to override the on-device key with a known one.
#define SOLANA_KEY ""

// ---- Helius RPC ------------------------------------------------------------
// Get one at https://dashboard.helius.dev/api-keys (free tier is plenty).
// Every RPC call (blockhash fetch, ATA lookup, balance refresh, memo
// writes) goes through Helius when this is set. Without a key the code
// falls back to the public Solana RPC, which rate-limits aggressively
// and starts dropping x402 payments after a handful of turns.
#define HELIUS_API_KEY "your-helius-api-key"

// ---- ElevenLabs TTS --------------------------------------------------------
// Get one at https://elevenlabs.io/app/settings/api-keys (starts with "sk_").
// The free tier is plenty for casual use.
#define ELEVENLABS_API_KEY  "your-elevenlabs-key"

// Voice ID. A few popular defaults:
//   pFZP5JQG7iQjIQuC4Bku  Lily     (cute, warm)
//   jBpfuIE2acCO8z3wKNLl  Gigi     (childlike, playful)
//   cgSgspJ2msm6clMCkdW9  Jessica  (warm, expressive)
//   Xb7hH8MSUJpSbSDYk0k2  Alice    (British, friendly)
//   21m00Tcm4TlvDq8ikWAM  Rachel   (soft, calm)
//   pNInz6obpgDQGcFmaJgB  Adam     (deep male)
#define ELEVENLABS_VOICE_ID "pFZP5JQG7iQjIQuC4Bku"

// `eleven_flash_v2_5` has the lowest synthesis latency (~75 ms TTFB).
// Quality is great for short spoken lines on a small speaker. Upgrade
// to `eleven_turbo_v2_5` or `eleven_multilingual_v2` only if a specific
// voice character suffers noticeably.
#define ELEVENLABS_MODEL    "eleven_flash_v2_5"

// ---- Piper TTS (local, on-LAN, optional) -----------------------------------
// When PIPER_HOST is set to a non-empty string, the firmware tries a
// local Piper HTTP server FIRST on every utterance and only falls back
// to ElevenLabs when it's unreachable or errors out. That gets
// first-audio down to ~200-400 ms on the same Wi-Fi (no TLS, no remote
// datacenter, no synthesis credits burned).
//
// Set PIPER_HOST to "" to disable the local path entirely and always
// go through ElevenLabs.
//
// On the host running Piper, something like:
//   nohup ~/.local/pipx/venvs/piper-tts/bin/python -m piper.http_server \
//     --host 0.0.0.0 --port 5500 \
//     --model en_US-amy-low --data-dir ~/piper-voices \
//     > ~/piper-voices/logs/server.log 2>&1 &
#define PIPER_HOST  ""
#define PIPER_PORT  5500
