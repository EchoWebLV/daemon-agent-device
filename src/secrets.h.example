// ============================================================================
//  Copy this file to `src/secrets.h` and fill in the real values.
//  `src/secrets.h` is gitignored so your keys never hit version control.
// ============================================================================
#pragma once

// ---- Wi-Fi -----------------------------------------------------------------
#define WIFI_SSID      "your-wifi-name"
#define WIFI_PASSWORD  "your-wifi-password"

// ---- Gemini ----------------------------------------------------------------
// Get one at https://aistudio.google.com/apikey
#define GEMINI_API_KEY "your-gemini-api-key"

// Any model that supports generateContent works. Flash is fast and cheap.
#define GEMINI_MODEL   "gemini-2.0-flash"

// ---- ElevenLabs TTS --------------------------------------------------------
// Get one at https://elevenlabs.io/app/settings/api-keys (starts with "sk_").
// The free tier is plenty for casual use.
#define ELEVENLABS_API_KEY  "your-elevenlabs-key"

// Voice ID from https://elevenlabs.io/app/voice-library. Defaults to Adam.
#define ELEVENLABS_VOICE_ID "pNInz6obpgDQGcFmaJgB"

// `eleven_turbo_v2_5` is the fastest and cheapest model. Swap to
// `eleven_multilingual_v2` for richer voice at higher latency.
#define ELEVENLABS_MODEL    "eleven_turbo_v2_5"

// ---- Moltbook (AI agent social network) -----------------------------------
// Register at https://www.moltbook.com or via the API. The key starts with
// "moltbook_sk_". Rate limit: 1 post per 30 minutes.
#define MOLTBOOK_API_KEY    "your-moltbook-api-key"
