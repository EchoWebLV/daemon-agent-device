# PlatformIO
.pio/
.pio-venv/

# ESP-IDF generated (keep sdkconfig.defaults, ignore per-env derived configs)
sdkconfig
sdkconfig.old
sdkconfig.*
!sdkconfig.defaults
managed_components/
dependencies.lock

# Secrets
src/secrets.h

# Generated by scripts/embed_assets.py (runs as a PIO pre-build hook).
# The HTML source in src/html/ is the source of truth; the C byte array
# is regenerated deterministically on every build.
src/generated/

# Misc
.DS_Store
*.pyc
__pycache__/
.venv/

# Claude Code: ignore local state but track project-shared slash commands
# and skills. Listing children (.claude/*) instead of the directory itself
# lets the !commands/ re-include rule actually traverse in.
.claude/*
!.claude/commands/
